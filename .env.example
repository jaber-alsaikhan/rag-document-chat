# Copy this file to ".env" and adjust the values. Never commit .env to git.

# Which LLM to use: "ollama" (local, default) or "groq" (hosted, for deployment)
LLM_PROVIDER=ollama

# Local Ollama server (default address) and the model to use for answers
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Only needed when LLM_PROVIDER=groq. Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Where ChromaDB stores its files
CHROMA_DIR=chroma_db

# Set to true on a public deployment: every visitor then gets a private,
# temporary index instead of sharing the one on disk.
PER_SESSION_INDEX=false

# Retrieval settings
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=75
